{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MCUDeviceSeries",
  "type": "object",
  "properties": {
    "family": { "type": "string" },
    "devices": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "family": { "type": "string" },
          "ram_kb": { "type": "integer" },
          "flash_kb": { "type": "integer" },
          "cpu_speed_mhz": { "type": "integer" },
          "peripherals": {
            "type": "array",
            "items": { "type": "string" }
          },
          "supported_frameworks": {
            "type": "array",
            "items": { "type": "string" }
          },
          "notes": { "type": "string" }
        },
        "required": ["name", "ram_kb", "flash_kb", "cpu_speed_mhz"]
      }
    }
  },
  "required": ["family", "devices"]
}
