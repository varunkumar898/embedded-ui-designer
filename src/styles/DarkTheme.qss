
/* ====== VIOLET DESIGN SYSTEM - APPLICATION STYLESHEET ====== */

QWidget {
    background-color: #0E0D15;
    color: #F4F2FC;
    font-size: 12px;
    font-weight: 500;
    selection-background-color: #2A2148;
    selection-color: #F4F2FC;
    outline: none;
}

QMainWindow {
    background-color: #0E0D15;
}

/* ── Menu Bar & Menus ────────────────────────────────────── */
QMenuBar {
    background-color: #151321;
    color: #F4F2FC;
    border: none;
    border-bottom: 1px solid #2B2445;
    padding: 2px 6px;
    font-size: 12px;
}

QMenuBar::item {
    background-color: transparent;
    color: #BDB6D9;
    padding: 5px 10px;
    border-radius: 4px;
}

QMenuBar::item:selected, QMenuBar::item:pressed {
    background-color: #241E3D;
    color: #F4F2FC;
}

QMenu {
    background-color: #151321;
    color: #F4F2FC;
    border: 1px solid #3D3360;
    border-radius: 8px;
    padding: 6px;
}

QMenu::item {
    background-color: transparent;
    color: #F4F2FC;
    padding: 6px 20px 6px 12px;
    border-radius: 4px;
    font-size: 12px;
}

QMenu::item:selected {
    background-color: #2A2148;
    color: #B7A4FF;
}

QMenu::item:disabled {
    color: #595374;
}

QMenu::separator {
    height: 1px;
    background-color: #2B2445;
    margin: 4px 6px;
}

/* ── Toolbars & Tool Buttons ─────────────────────────────── */
QToolBar {
    background-color: #1C1930;
    border: none;
    border-bottom: 1px solid #2B2445;
    spacing: 4px;
    padding: 4px 8px;
}

QToolBar::separator {
    width: 1px;
    background-color: #2B2445;
    margin: 4px 6px;
}

QToolButton {
    background-color: transparent;
    color: #F4F2FC;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 4px 8px;
    font-size: 12px;
    font-weight: 500;
}

QToolButton:hover {
    background-color: #241E3D;
    border: 1px solid #2B2445;
    color: #F4F2FC;
}

QToolButton:pressed {
    background-color: #151321;
}

QToolButton:checked {
    background-color: #2A2148;
    border: 1px solid #7C5CFF;
    color: #B7A4FF;
}

QToolButton::menu-indicator {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    right: 4px;
}

/* ── Dock Widgets ────────────────────────────────────────── */
QDockWidget {
    background-color: #151321;
    color: #F4F2FC;
    border: 1px solid #2B2445;
    font-size: 12px;
}

QDockWidget::title {
    background-color: #151321;
    padding: 8px 12px;
    border-bottom: 1px solid #2B2445;
    font-weight: 600;
    font-size: 13px;
    color: #F4F2FC;
}

#customDockTitle {
    background-color: #151321;
    border-bottom: 1px solid #2B2445;
}

#panelTitle {
    color: #F4F2FC;
    font-size: 13px;
    font-weight: 600;
}

/* ── Push Buttons ────────────────────────────────────────── */
QPushButton {
    background-color: #1C1930;
    color: #F4F2FC;
    border: 1px solid #2B2445;
    border-radius: 6px;
    padding: 6px 14px;
    font-size: 12px;
    font-weight: 500;
    min-height: 20px;
    outline: none;
}

QPushButton:hover {
    background-color: #241E3D;
    border: 1px solid #3D3360;
}

QPushButton:pressed {
    background-color: #151321;
    border: 1px solid #7C5CFF;
}

QPushButton:disabled {
    background-color: #151321;
    color: #595374;
    border: 1px solid #2B2445;
}

/* Primary Button (Action focus) */
QPushButton#primaryButton, QPushButton[primary="true"] {
    background-color: #7C5CFF;
    color: #FFFFFF;
    border: 1px solid #7C5CFF;
    font-weight: 600;
}

QPushButton#primaryButton:hover, QPushButton[primary="true"]:hover {
    background-color: #9478FF;
    border: 1px solid #9478FF;
}

QPushButton#primaryButton:pressed, QPushButton[primary="true"]:pressed {
    background-color: #6847E8;
    border: 1px solid #6847E8;
}

/* Flat / Toolbar Button */
QPushButton#flatButton, QPushButton[flat="true"] {
    background-color: transparent;
    color: #BDB6D9;
    border: none;
    min-width: 0px;
    padding: 3px 6px;
    border-radius: 4px;
}

QPushButton#flatButton:hover, QPushButton[flat="true"]:hover {
    background-color: #241E3D;
    color: #F4F2FC;
}

QPushButton#flatButton:pressed, QPushButton[flat="true"]:pressed {
    background-color: #151321;
}

/* ── Text Inputs ─────────────────────────────────────────── */
QLineEdit, QPlainTextEdit, QTextEdit {
    background-color: #1C1930;
    color: #F4F2FC;
    border: 1px solid #2B2445;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 12px;
    selection-background-color: #2A2148;
    selection-color: #B7A4FF;
}

QLineEdit:hover, QPlainTextEdit:hover, QTextEdit:hover {
    border: 1px solid #3D3360;
}

QLineEdit:focus, QPlainTextEdit:focus, QTextEdit:focus {
    border: 1px solid #7C5CFF;
}

QLineEdit::placeholder, QPlainTextEdit::placeholder, QTextEdit::placeholder {
    color: #837CA6;
}

/* ── Spin Boxes ──────────────────────────────────────────── */
QSpinBox, QDoubleSpinBox {
    background-color: #1C1930;
    color: #F4F2FC;
    border: 1px solid #2B2445;
    border-radius: 6px;
    padding: 4px 8px;
    font-size: 12px;
}

QSpinBox:hover, QDoubleSpinBox:hover {
    border: 1px solid #3D3360;
}

QSpinBox:focus, QDoubleSpinBox:focus {
    border: 1px solid #7C5CFF;
}

QSpinBox::up-button, QSpinBox::down-button,
QDoubleSpinBox::up-button, QDoubleSpinBox::down-button {
    background-color: transparent;
    border: none;
    width: 16px;
}

/* ── Combo Boxes ─────────────────────────────────────────── */
QComboBox {
    background-color: #1C1930;
    color: #F4F2FC;
    border: 1px solid #2B2445;
    border-radius: 6px;
    padding: 5px 12px;
    font-size: 12px;
    min-height: 20px;
}

QComboBox:hover {
    border: 1px solid #3D3360;
}

QComboBox:focus, QComboBox:on {
    border: 1px solid #7C5CFF;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 24px;
    border: none;
}

QComboBox QAbstractItemView {
    background-color: #151321;
    color: #F4F2FC;
    border: 1px solid #3D3360;
    border-radius: 8px;
    padding: 4px;
    selection-background-color: #2A2148;
    selection-color: #B7A4FF;
}

/* ── Scroll Bars (Thin 8px rounded) ──────────────────────── */
QScrollBar:vertical {
    background-color: #151321;
    width: 8px;
    margin: 0px;
    border-radius: 4px;
}

QScrollBar::handle:vertical {
    background-color: #2B2445;
    min-height: 24px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background-color: #2A2148;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
    background: none;
}

QScrollBar:horizontal {
    background-color: #151321;
    height: 8px;
    margin: 0px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal {
    background-color: #2B2445;
    min-width: 24px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #2A2148;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
    background: none;
}

/* ── Tab Widgets & Tab Bars ──────────────────────────────── */
QTabWidget::pane {
    border: 1px solid #2B2445;
    background-color: #151321;
    border-radius: 6px;
}

QTabBar::tab {
    background-color: #151321;
    color: #837CA6;
    border: 1px solid transparent;
    padding: 6px 14px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    font-size: 12px;
    font-weight: 500;
}

QTabBar::tab:hover {
    background-color: #1C1930;
    color: #BDB6D9;
}

QTabBar::tab:selected {
    background-color: #1C1930;
    color: #F4F2FC;
    border-bottom: 2px solid #7C5CFF;
    font-weight: 600;
}

/* ── Item Views (Trees, Lists, Tables) ───────────────────── */
QTreeWidget, QListWidget, QTableWidget {
    background-color: #151321;
    color: #F4F2FC;
    border: 1px solid #2B2445;
    border-radius: 6px;
    padding: 4px;
    font-size: 12px;
}

QTreeWidget::item, QListWidget::item, QTableWidget::item {
    padding: 4px 8px;
    border-radius: 4px;
}

QTreeWidget::item:hover, QListWidget::item:hover, QTableWidget::item:hover {
    background-color: #241E3D;
    color: #F4F2FC;
}

QTreeWidget::item:selected, QListWidget::item:selected, QTableWidget::item:selected {
    background-color: #2A2148;
    color: #B7A4FF;
    border: none;
}

QHeaderView::section {
    background-color: #1C1930;
    color: #BDB6D9;
    border: none;
    border-bottom: 1px solid #2B2445;
    border-right: 1px solid #2B2445;
    padding: 6px 10px;
    font-weight: 600;
    font-size: 12px;
}

/* ── Check Boxes & Radio Buttons ─────────────────────────── */
QCheckBox, QRadioButton {
    color: #F4F2FC;
    spacing: 8px;
    font-size: 12px;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 16px;
    height: 16px;
    background-color: #1C1930;
    border: 1px solid #2B2445;
    border-radius: 4px;
}

QRadioButton::indicator {
    border-radius: 8px;
}

QCheckBox::indicator:hover, QRadioButton::indicator:hover {
    border: 1px solid #3D3360;
}

QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background-color: #7C5CFF;
    border: 1px solid #7C5CFF;
}

/* ── Sliders ─────────────────────────────────────────────── */
QSlider::groove:horizontal {
    background-color: #2B2445;
    height: 4px;
    border-radius: 2px;
}

QSlider::sub-page:horizontal {
    background-color: #7C5CFF;
    height: 4px;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background-color: #F4F2FC;
    width: 14px;
    height: 14px;
    margin: -5px 0;
    border-radius: 7px;
    border: 1px solid #3D3360;
}

QSlider::handle:horizontal:hover {
    background-color: #FFFFFF;
    border: 2px solid #7C5CFF;
}

/* ── Progress Bars ───────────────────────────────────────── */
QProgressBar {
    background-color: #1C1930;
    border: 1px solid #2B2445;
    border-radius: 4px;
    text-align: center;
    color: #F4F2FC;
    font-size: 11px;
    height: 12px;
}

QProgressBar::chunk {
    background-color: #7C5CFF;
    border-radius: 3px;
}

/* ── Group Boxes ─────────────────────────────────────────── */
QGroupBox {
    border: 1px solid #2B2445;
    border-radius: 6px;
    margin-top: 12px;
    padding-top: 12px;
    font-size: 12px;
    font-weight: 600;
    color: #BDB6D9;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 4px;
    color: #B7A4FF;
}

/* ── Status Bar ──────────────────────────────────────────── */
QStatusBar {
    background-color: #151321;
    border-top: 1px solid #2B2445;
    color: #BDB6D9;
    font-size: 12px;
}

QStatusBar QLabel {
    background-color: transparent;
}

/* ── Tool Tips ───────────────────────────────────────────── */
QToolTip {
    background-color: #241E3D;
    color: #F4F2FC;
    border: 1px solid #3D3360;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 11px;
}

/* ── Splitters ───────────────────────────────────────────── */
QSplitter::handle {
    background-color: #2B2445;
}

QSplitter::handle:hover {
    background-color: #7C5CFF;
}

/* ── Dialogs ─────────────────────────────────────────────── */
QDialog {
    background-color: #0E0D15;
    color: #F4F2FC;
}
