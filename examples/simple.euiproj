{
  "version": "1.0",
  "name": "SimpleApp",
  "target": "ugfx",
  "display": {
    "width": 320,
    "height": 240,
    "colorDepth": 16,
    "type": "LCD",
    "dpi": 96
  },
  "pages": [
    {
      "id": "MainScreen",
      "width": 320,
      "height": 240,
      "backgroundColor": "#1e1e24",
      "components": [
        {
          "id": "rect_panel",
          "type": "Rectangle",
          "x": 10,
          "y": 10,
          "width": 300,
          "height": 220,
          "fillColor": "#292b36",
          "strokeColor": "#3f4354",
          "strokeWidth": 1,
          "cornerRadius": 6
        },
        {
          "id": "label_title",
          "type": "Text",
          "x": 20,
          "y": 25,
          "width": 280,
          "height": 30,
          "text": "µGFX Embedded Demo",
          "color": "#ffffff",
          "font": {
            "family": "DejaVuSans",
            "pixelSize": 16,
            "bold": true,
            "italic": false
          }
        },
        {
          "id": "btn_press",
          "type": "Button",
          "x": 20,
          "y": 55,
          "width": 120,
          "height": 34,
          "text": "Press Me",
          "backgroundColor": "#2196f3",
          "textColor": "#ffffff",
          "cornerRadius": 4,
          "onClicked": "onPressMe"
        },
        {
          "id": "switch_toggle",
          "type": "Switch",
          "x": 160,
          "y": 59,
          "width": 50,
          "height": 26,
          "checked": true,
          "onColor": "#4caf50",
          "offColor": "#3f4354",
          "thumbColor": "#ffffff",
          "onToggled": "onTogglePower"
        },
        {
          "id": "prog_level",
          "type": "ProgressBar",
          "x": 20,
          "y": 100,
          "width": 280,
          "height": 16,
          "value": 0.5,
          "barColor": "#4caf50",
          "trackColor": "#15161c",
          "cornerRadius": 3
        },
        {
          "id": "slider_volume",
          "type": "Slider",
          "x": 20,
          "y": 130,
          "width": 280,
          "height": 26,
          "value": 45,
          "minimum": 0,
          "maximum": 100,
          "trackColor": "#292b36",
          "fillColor": "#009688",
          "handleColor": "#ffffff"
        },
        {
          "id": "chk_wifi",
          "type": "Checkbox",
          "x": 20,
          "y": 170,
          "width": 160,
          "height": 24,
          "text": "Enable Wi-Fi",
          "checked": true,
          "textColor": "#e0e0e0",
          "checkColor": "#4caf50",
          "boxColor": "#22252f",
          "borderColor": "#4e5569",
          "onToggled": "onWifiToggled"
        }
      ]
    }
  ],
  "assets": []
}
