{
  "version": "1.0",
  "name": "SimpleApp",
  "target": "ugfx",
  "display": {
    "width": 320,
    "height": 240,
    "colorDepth": 16,
    "type": "LCD",
    "dpi": 96
  },
  "pages": [
    {
      "id": "MainScreen",
      "width": 320,
      "height": 240,
      "backgroundColor": "#1e1e24",
      "components": [
        {
          "id": "rect_panel",
          "type": "Rectangle",
          "x": 10,
          "y": 10,
          "width": 300,
          "height": 220,
          "fillColor": "#292b36",
          "strokeColor": "#3f4354",
          "strokeWidth": 1,
          "cornerRadius": 6
        },
        {
          "id": "label_title",
          "type": "Text",
          "x": 20,
          "y": 25,
          "width": 280,
          "height": 30,
          "text": "µGFX Embedded Demo",
          "color": "#ffffff",
          "font": {
            "family": "DejaVuSans",
            "pixelSize": 16,
            "bold": true,
            "italic": false
          }
        },
        {
          "id": "btn_press",
          "type": "Button",
          "x": 20,
          "y": 50,
          "width": 100,
          "height": 30,
          "text": "Press Me",
          "backgroundColor": "#2196f3",
          "textColor": "#ffffff",
          "cornerRadius": 4,
          "onClicked": "onPressMe"
        },
        {
          "id": "switch_toggle",
          "type": "Switch",
          "x": 135,
          "y": 52,
          "width": 45,
          "height": 24,
          "checked": true,
          "onColor": "#4caf50",
          "offColor": "#3f4354",
          "thumbColor": "#ffffff",
          "onToggled": "onTogglePower"
        },
        {
          "id": "chk_wifi",
          "type": "Checkbox",
          "x": 195,
          "y": 52,
          "width": 105,
          "height": 24,
          "text": "Wi-Fi",
          "checked": true,
          "textColor": "#e0e0e0",
          "checkColor": "#4caf50",
          "boxColor": "#22252f",
          "borderColor": "#4e5569",
          "onToggled": "onWifiToggled"
        },
        {
          "id": "prog_level",
          "type": "ProgressBar",
          "x": 20,
          "y": 90,
          "width": 280,
          "height": 14,
          "value": 0.5,
          "barColor": "#4caf50",
          "trackColor": "#15161c",
          "cornerRadius": 3
        },
        {
          "id": "slider_volume",
          "type": "Slider",
          "x": 20,
          "y": 115,
          "width": 280,
          "height": 24,
          "value": 45,
          "minimum": 0,
          "maximum": 100,
          "trackColor": "#292b36",
          "fillColor": "#009688",
          "handleColor": "#ffffff"
        },
        {
          "id": "txt_username",
          "type": "TextInput",
          "x": 20,
          "y": 150,
          "width": 280,
          "height": 28,
          "text": "admin",
          "placeholder": "Enter username...",
          "textColor": "#ffffff",
          "placeholderColor": "#717c8f",
          "backgroundColor": "#1e212b",
          "borderColor": "#3e4459",
          "borderWidth": 1,
          "cornerRadius": 4,
          "pixelSize": 12,
          "readOnly": false,
          "onTextChanged": "onUserChanged"
        },
        {
          "id": "circ_status",
          "type": "Circle",
          "x": 20,
          "y": 188,
          "width": 24,
          "height": 24,
          "fillColor": "#00e676",
          "strokeColor": "#ffffff",
          "strokeWidth": 1,
          "isFilled": true
        }
      ]
    }
  ],
  "assets": []
}
