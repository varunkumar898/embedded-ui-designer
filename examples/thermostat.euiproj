{
  "version": "1.0",
  "name": "Thermostat",
  "target": "qt-for-mcus",
  "display": { "width": 320, "height": 240, "colorDepth": 16, "type": "LCD", "dpi": 96 },
  "pages": [{
    "id": "MainScreen",
    "width": 320,
    "height": 240,
    "backgroundColor": "#111820",
    "components": [
      { "id": "room_panel", "type": "Rectangle", "x": 12, "y": 12, "width": 296, "height": 216, "fillColor": "#202c35", "strokeColor": "#3a4b55", "strokeWidth": 1, "cornerRadius": 8 },
      { "id": "room_title", "type": "Text", "x": 28, "y": 23, "width": 260, "height": 24, "text": "LIVING ROOM", "color": "#a9c0ca", "font": { "family": "DejaVuSans", "pixelSize": 13, "bold": true, "italic": false } },
      { "id": "room_temperature", "type": "Text", "x": 28, "y": 55, "width": 190, "height": 55, "text": "22.5 C", "color": "#f4f7f8", "font": { "family": "DejaVuSans", "pixelSize": 34, "bold": true, "italic": false } },
      { "id": "humidity_label", "type": "Text", "x": 28, "y": 113, "width": 120, "height": 20, "text": "HUMIDITY  48%", "color": "#77c7d4", "font": { "family": "DejaVuSans", "pixelSize": 11, "bold": false, "italic": false } },
      { "id": "humidity_bar", "type": "ProgressBar", "x": 28, "y": 139, "width": 264, "height": 12, "value": 0.48, "barColor": "#48aebd", "trackColor": "#172127", "cornerRadius": 4 },
      { "id": "cool_button", "type": "Button", "x": 28, "y": 171, "width": 112, "height": 38, "text": "COOL", "backgroundColor": "#257f9b", "textColor": "#ffffff", "cornerRadius": 5, "onClicked": "setCooling" },
      { "id": "heat_button", "type": "Button", "x": 156, "y": 171, "width": 136, "height": 38, "text": "HEAT  ON", "backgroundColor": "#b7573c", "textColor": "#ffffff", "cornerRadius": 5, "onClicked": "setHeating" }
    ]
  }],
  "assets": []
}