# ESP-IDF SDK Configuration for ESP32 DevKit
#
CONFIG_IDF_TARGET="esp32"
CONFIG_IDF_TARGET_ESP32=y
CONFIG_EXAMPLE_ADC_PIN=34
CONFIG_EXAMPLE_PWM_PIN=16
CONFIG_EXAMPLE_I2C_SCL_PIN=22
CONFIG_EXAMPLE_I2C_SDA_PIN=21
CONFIG_EXAMPLE_SPI_MOSI_PIN=23
CONFIG_EXAMPLE_SPI_MISO_PIN=19
CONFIG_EXAMPLE_SPI_CLK_PIN=18
CONFIG_EXAMPLE_SPI_CS_PIN=5
CONFIG_BLINK_GPIO=2
CONFIG_BUTTON_GPIO=0
CONFIG_UNKNOWN_SUBSYSTEM_PIN=999
