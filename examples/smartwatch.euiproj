{
  "version": "1.0",
  "name": "Smartwatch",
  "target": "qt-for-mcus",
  "display": { "width": 240, "height": 240, "colorDepth": 16, "type": "LCD", "dpi": 96 },
  "pages": [{
    "id": "MainScreen",
    "width": 240,
    "height": 240,
    "backgroundColor": "#10151a",
    "components": [
      { "id": "watch_outer", "type": "Circle", "x": 14, "y": 14, "width": 212, "height": 212, "fillColor": "#1a252b", "strokeColor": "#425b61", "strokeWidth": 3, "isFilled": true },
      { "id": "watch_inner", "type": "Circle", "x": 25, "y": 25, "width": 190, "height": 190, "fillColor": "#10191e", "strokeColor": "#2d4146", "strokeWidth": 1, "isFilled": true },
      { "id": "watch_time", "type": "Text", "x": 55, "y": 61, "width": 130, "height": 46, "text": "09:41", "color": "#f1f7f4", "font": { "family": "DejaVuSans", "pixelSize": 31, "bold": true, "italic": false } },
      { "id": "watch_date", "type": "Text", "x": 66, "y": 108, "width": 110, "height": 20, "text": "TUE  24 SEP", "color": "#9bb1b1", "font": { "family": "DejaVuSans", "pixelSize": 10, "bold": true, "italic": false } },
      { "id": "activity_label", "type": "Text", "x": 48, "y": 142, "width": 60, "height": 18, "text": "MOVE", "color": "#91b7ae", "font": { "family": "DejaVuSans", "pixelSize": 10, "bold": true, "italic": false } },
      { "id": "activity_progress", "type": "ProgressBar", "x": 48, "y": 164, "width": 144, "height": 10, "value": 0.72, "barColor": "#62c6a0", "trackColor": "#26373a", "cornerRadius": 4 },
      { "id": "battery_icon", "type": "Circle", "x": 102, "y": 187, "width": 12, "height": 12, "fillColor": "#e2b85f", "strokeColor": "#e2b85f", "strokeWidth": 1, "isFilled": true },
      { "id": "battery_label", "type": "Text", "x": 119, "y": 184, "width": 55, "height": 18, "text": "82%", "color": "#d2dfd9", "font": { "family": "DejaVuSans", "pixelSize": 12, "bold": true, "italic": false } },
      { "id": "watch_button", "type": "Button", "x": 83, "y": 204, "width": 74, "height": 16, "text": "ACTIVITY", "backgroundColor": "#315b50", "textColor": "#eff9f4", "cornerRadius": 5, "onClicked": "openActivity" }
    ]
  }],
  "assets": []
}